# Secrets: never commit
.env
.env.*
!.env.example

# Provided reference file: must not be in the submission repo
starter_agent.py

# Python
__pycache__/
*.pyc
.venv/

# Local run artifacts (commit only curated scorecards)
results/raw/

# Assignment brief (not ours to publish)
2606_Tavily_FDE_TakeHomeAssignment.md
results/log_*.txt
results/sec/
.pytest_cache/
results/archive_superseded/
results/tavily_cache/

# Chat UI runtime files (Chainlit writes translations on start; only the edited English strings are kept)
ui/.files/
ui/.chainlit/translations/*
!ui/.chainlit/translations/en-US.json

# Terraform (local state stays on the machine that applies it)
infra/.terraform/
infra/*.tfstate
infra/*.tfstate.*

# Per-question run records (large; scorecards and results/final/exact50.md are committed instead)
results/final/records/

# Chainlit writes this when the UI is started from the repo root
/.chainlit/
# Per-run outputs the harness writes at the top of results/ (curated results live in results/final/)
/results/scorecard_*.md
/results/summary_*.json
/results/judge_sample_*.md
/results/compare_*.md
